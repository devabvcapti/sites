    | "drop"
    | "globe"
    | "handshake"
    | "chart"
    | "calendar"
    | "map-pin"
    | "mail"
    | "phone"
    | "arrow-right"
    | "menu"
    | "close"
    | "check-circle"
    | "alert-circle"
    | "instagram"
    | "linkedin"
    | "youtube"
    | "building"
    | "sparkle"
    | "chevron-down";
