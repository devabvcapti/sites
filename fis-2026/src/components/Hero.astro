---
import { Image } from "astro:assets";
import posterImage from "../assets/images/hero-video-poster.jpg";
import Icon from "./Icon.astro";
---

<section class="hero" aria-label="Abertura">
  <div class="hero__media" aria-hidden="true">
    <video
      class="hero__video"
      data-hero-video
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="/videos/hero-wind.webm" type="video/webm" />
      <source src="/videos/hero-wind.mp4" type="video/mp4" />
    </video>
    <Image
      src={posterImage}
      alt=""
      widths={[640, 1024, 1600, 2200]}
      sizes="100vw"
      format="avif"
      quality={72}
      loading="eager"
      fetchpriority="high"
      class="hero__image"
      data-hero-poster
    />
    <div class="hero__scrim"></div>
    <div class="hero__grain"></div>
  </div>

  <div class="container hero__content">
    <p class="hero__eyebrow" data-reveal style="--reveal-delay:0ms">
      <Icon name="sparkle" size={16} /> ABVCAP · Fórum de Investimentos Sustentáveis
    </p>

    <h1 class="hero__title" data-reveal style="--reveal-delay:80ms">
      O capital privado que <em>movimenta</em> a agenda da sustentabilidade no Brasil
    </h1>

    <p class="hero__subtitle" data-reveal style="--reveal-delay:160ms">
      Gestores de fundos, investidores institucionais e formuladores de política se
      encontram em São Paulo para discutir como capital, impacto e retorno andam juntos.
    </p>

    <div class="hero__actions" data-reveal style="--reveal-delay:240ms">
      <a href="#lp-day" class="btn btn--primary">
        Quero me inscrever <Icon name="arrow-right" size={18} />
      </a>
      <a href="#evento" class="btn btn--outline-light">Ver programação</a>
    </div>

    <dl class="hero__facts" data-reveal style="--reveal-delay:320ms">
      <div class="hero__fact">
        <dt><Icon name="calendar" size={18} /> Data</dt>
        <dd>A definir · 2026</dd>
      </div>
      <div class="hero__fact">
        <dt><Icon name="map-pin" size={18} /> Local</dt>
        <dd>São Paulo, SP</dd>
      </div>
      <div class="hero__fact">
        <dt><Icon name="handshake" size={18} /> Formato</dt>
        <dd>Presencial · convite ABVCAP</dd>
      </div>
    </dl>
  </div>

  <a href="#evento" class="hero__scroll-cue" aria-label="Rolar para o conteúdo">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--navy-950);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__video,
  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    transform: scale(1.02);
  }

  .hero__image {
    transition: opacity var(--duration-slow) var(--ease-out-quart);
  }

  .hero__media[data-video-active="true"] .hero__image {
    opacity: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        180deg,
        color-mix(in oklch, var(--navy-950) 78%, transparent) 0%,
        color-mix(in oklch, var(--navy-950) 35%, transparent) 40%,
        color-mix(in oklch, var(--navy-950) 55%, transparent) 68%,
        var(--navy-950) 100%
      ),
      linear-gradient(
        100deg,
        color-mix(in oklch, var(--green-800) 55%, transparent) 0%,
        transparent 55%
      );
  }

  .hero__grain {
    position: absolute;
    inset: 0;
    mix-blend-mode: overlay;
    opacity: 0.5;
    background-image: radial-gradient(
      color-mix(in oklch, var(--white) 6%, transparent) 1px,
      transparent 1px
    );
    background-size: 3px 3px;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    min-width: 0;
    padding-block: var(--space-3xl) var(--space-2xl);
    max-width: 46rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--green-400);
    font-weight: 700;
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }

  .hero__title {
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    color: var(--white);
    text-wrap: balance;
  }

  .hero__title em {
    font-style: normal;
    color: var(--green-400);
  }

  .hero__subtitle {
    margin-top: var(--space-md);
    max-width: 38rem;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-normal);
    color: var(--text-on-navy-muted);
    text-wrap: pretty;
  }

  .hero__actions {
    margin-top: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero__facts {
    margin-top: var(--space-2xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid color-mix(in oklch, var(--white) 18%, transparent);
    max-width: 40rem;
  }

  .hero__fact dt {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--green-400);
  }

  .hero__fact dd {
    margin: var(--space-3xs) 0 0;
    font-weight: 600;
    color: var(--white);
  }

  .hero__scroll-cue {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: var(--space-md);
    transform: translateX(-50%);
    width: 1.75rem;
    height: 2.75rem;
    border: 1.5px solid color-mix(in oklch, var(--white) 55%, transparent);
    border-radius: var(--radius-pill);
    display: none;
  }

  .hero__scroll-cue span {
    position: absolute;
    top: 0.4rem;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--white);
    transform: translateX(-50%);
    animation: scroll-cue 1.8s var(--ease-out-quart) infinite;
  }

  @keyframes scroll-cue {
    0% {
      transform: translate(-50%, 0);
      opacity: 1;
    }
    70% {
      opacity: 0;
    }
    100% {
      transform: translate(-50%, 1rem);
      opacity: 0;
    }
  }

  @media (min-width: 720px) {
    .hero__scroll-cue {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-cue span {
      animation: none;
    }
  }

  [data-reveal] {
    transition-delay: var(--reveal-delay, 0ms);
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const media = video?.closest<HTMLElement>(".hero__media");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (video && media && !reducedMotion.matches) {
    video.addEventListener(
      "playing",
      () => {
        media.dataset.videoActive = "true";
      },
      { once: true }
    );
    video.play().catch(() => {
      /* Autoplay blocked or source unavailable — the poster image stays visible. */
    });
  }
</script>
